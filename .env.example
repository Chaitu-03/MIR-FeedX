# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# pydantic-settings v2 requires JSON array syntax for list fields
TUMBLR_API_KEYS=["your_consumer_key_here"]
# Multiple keys: TUMBLR_API_KEYS=["key1","key2"]
# No key yet:    TUMBLR_API_KEYS=[]
# For OAuth secret, set it in your shell environment or a secrets manager:
# TUMBLR_OAUTH_SECRET=your_secret_key_here

DATABASE_URL=postgresql+asyncpg://mir:mir@localhost:5432/mir
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost

NSFW_THRESHOLD=0.75
TARGET_POST_COUNT=50000
# Beat interval for crawl_active_blogs. 15 = quick verification, 30–60 = staging, 360 = production (6h).
CRAWL_INTERVAL_MINUTES=15
LOG_LEVEL=INFO
