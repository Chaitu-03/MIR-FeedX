# Copy to .env and fill in real values. .env is gitignored.

# Tumblr API credentials — list of {consumer_key, secret} pairs (JSON).
# Multiple credentials enable round-robin rotation; on 429/403 a key is put on
# cooldown (5 min for 429, session-long for 403/401) and the next key is used.
# If no credentials are set, the crawler will refuse to start.
TUMBLR_API_CREDENTIALS=[{"consumer_key":"your_consumer_key_here","secret":"your_secret_here"}]
# Multiple example:
# TUMBLR_API_CREDENTIALS=[{"consumer_key":"k1","secret":"s1"},{"consumer_key":"k2","secret":"s2"}]

# Legacy fallback — only used if TUMBLR_API_CREDENTIALS is empty.
TUMBLR_API_KEYS=[]

DATABASE_URL=postgresql+asyncpg://mir:mir@localhost:5432/mir
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost

NSFW_THRESHOLD=0.75
TARGET_POST_COUNT=50000
# Beat interval for crawl_active_blogs. 15 = verification, 30–60 = staging, 360 = production (6h).
CRAWL_INTERVAL_MINUTES=15
LOG_LEVEL=INFO
HF_TOKEN=your_huggingface_token_here
